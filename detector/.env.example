BACKEND_URL=http://127.0.0.1:8000
DETECTOR_API_KEY=detector-secret-key

# YOLO pose model (auto-downloaded on first run). Larger = more accurate: yolo11s-pose.pt, yolo11m-pose.pt
POSE_MODEL=yolo11n-pose.pt
# Optional custom fire/smoke YOLO weights (see train_fire_smoke.py). Empty = OpenCV colour/motion heuristic.
FIRE_SMOKE_MODEL=
# cpu, 0 (first CUDA GPU), mps ... empty = auto
DEVICE=

PERSON_CONF=0.15
FIRE_SMOKE_CONF=0.35
PROCESS_FPS=10
MAX_FRAME_WIDTH=960

CLIP_PRE_SECONDS=5
CLIP_POST_SECONDS=6
COOLDOWN_SECONDS=60

STREAM_PORT=8100
CAMERA_REFRESH_SECONDS=15
# Comma-separated camera ids handled by this detector instance (empty = all active cameras)
CAMERA_IDS=

# PyTorch threads per inference call (cameras run in parallel threads)
TORCH_THREADS=2
# Fire/smoke model input size (it was trained at 320)
FIRE_SMOKE_IMGSZ=320
# Pose model input size (480 = ~1.5x faster than 640 with the same fall recall on UR Fall)
POSE_IMGSZ=480
